<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pragma LMS Admin Paneli</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', system-ui, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }
        .sidebar {
            width: 260px;
            min-height: 100vh;
            background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);
            color: #e2e8f0;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 100;
        }
        .sidebar .nav-link {
            color: #94a3b8;
            font-weight: 500;
            font-size: 0.875rem;
            padding: 0.75rem 1.25rem;
            border-radius: 0.5rem;
            margin: 0.2rem 0.75rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            transition: all 0.2s ease;
        }
        .sidebar .nav-link:hover, .sidebar .nav-link.active {
            color: #ffffff;
            background-color: rgba(255, 255, 255, 0.1);
        }
        .sidebar .nav-link.active {
            background-color: #3b82f6;
            color: #ffffff;
            font-weight: 600;
        }
        .main-content {
            margin-left: 260px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .topbar {
            background-color: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 1.5rem;
            position: sticky;
            top: 0;
            z-index: 99;
        }
        .card {
            border: 1px solid #e2e8f0;
            border-radius: 1rem;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
        }
        .badge-soft-success {
            background-color: #dcfce7;
            color: #15803d;
        }
        .badge-soft-warning {
            background-color: #fef3c7;
            color: #b45309;
        }
        .badge-soft-primary {
            background-color: #dbeafe;
            color: #1d4ed8;
        }
    </style>
</head>
<body>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- SOL MENYU (SIDEBAR) -->
        <aside class="sidebar">
            <div class="p-3 border-bottom border-secondary border-opacity-25 d-flex align-items-center gap-2">
                <div class="bg-primary text-white rounded-3 p-2 d-flex align-items-center justify-content-center shadow-sm" style="width: 36px; height: 36px;">
                    <i class="fa-solid fa-graduation-cap"></i>
                </div>
                <div>
                    <h6 class="mb-0 fw-bold text-white tracking-wide">PRAGMA LMS</h6>
                    <small class="text-secondary" style="font-size: 11px;">Admin İdarəetmə Paneli</small>
                </div>
            </div>

            <div class="py-3">
                <div class="px-3 pb-2 text-uppercase text-secondary fw-bold" style="font-size: 11px; letter-spacing: 0.5px;">Əsas Menyu</div>
                <nav class="nav flex-column">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                        <i class="fa-solid fa-chart-pie"></i> İdarəetmə Paneli
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Courses" ? "active" : "")" asp-controller="Courses" asp-action="Index">
                        <i class="fa-solid fa-book-open"></i> Kurslar & Modullar
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")" asp-controller="Categories" asp-action="Index">
                        <i class="fa-solid fa-layer-group"></i> Kateqoriyalar
                    </a>
                </nav>

                <div class="px-3 pt-4 pb-2 text-uppercase text-secondary fw-bold" style="font-size: 11px; letter-spacing: 0.5px;">Xarici Keçidlər</div>
                <nav class="nav flex-column">
                    <a class="nav-link text-info" href="http://localhost:5298/portal/index.html" target="_blank">
                        <i class="fa-solid fa-laptop-code"></i> Tələbə Portalı & Pleyer <i class="fa-solid fa-arrow-up-right-from-square ms-auto text-secondary" style="font-size: 10px;"></i>
                    </a>
                    <a class="nav-link text-warning" href="http://localhost:5298/scalar/v1" target="_blank">
                        <i class="fa-solid fa-code"></i> Scalar API Sənədləri <i class="fa-solid fa-arrow-up-right-from-square ms-auto text-secondary" style="font-size: 10px;"></i>
                    </a>
                </nav>
            </div>
        </aside>

        <!-- ƏSAS SAHƏ -->
        <div class="main-content">
            <!-- ÜST PANEL (TOPBAR) -->
            <header class="topbar">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary bg-opacity-10 text-primary fw-semibold px-2.5 py-1.5 rounded-pill font-monospace" style="font-size: 11px;">
                        .NET 10 Onion Architecture
                    </span>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 34px; height: 34px; font-size: 13px;">
                            @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "A")
                        </div>
                        <div class="d-none d-sm-block text-end">
                            <div class="fw-semibold text-dark" style="font-size: 13px;">@User.Identity?.Name</div>
                            <span class="badge bg-danger bg-opacity-10 text-danger" style="font-size: 10px;">Admin</span>
                        </div>
                    </div>

                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3" title="Sistemdən çıxış">
                            <i class="fa-solid fa-right-from-bracket"></i> <span class="d-none d-md-inline ms-1">Çıxış</span>
                        </button>
                    </form>
                </div>
            </header>

            <!-- BƏDƏN (BODY) -->
            <main class="p-4 flex-grow-1">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm" role="alert">
                        <i class="fa-solid fa-circle-check me-2"></i> @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm" role="alert">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>

            <!-- AŞAĞI PANEL (FOOTER) -->
            <footer class="p-3 text-center text-muted border-top bg-white" style="font-size: 12px;">
                &copy; 2026 <strong>Pragma LMS</strong> — Bütün hüquqlar qorunur.
            </footer>
        </div>
    }
    else
    {
        @RenderBody()
    }

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
