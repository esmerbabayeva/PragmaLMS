@model Pragma.Application.DTOs.Courses.CourseDetailDto
@using Pragma.Domain.Enums
@{
    ViewData["Title"] = Model.Title;
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div class="d-flex align-items-center gap-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-circle p-2" style="width: 36px; height: 36px;">
            <i class="fa-solid fa-arrow-left"></i>
        </a>
        <div>
            <h4 class="fw-bold mb-0">@Model.Title</h4>
            <small class="text-muted">Təlimçi: @Model.InstructorName | Kateqoriya: @Model.CategoryName</small>
        </div>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Gradebook" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3">
            <i class="fa-solid fa-table-list me-1"></i> Qiymət Jurnalı
        </a>
        @if (Model.Status == CourseStatus.Published)
        {
            <form asp-action="Unpublish" asp-route-id="@Model.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-warning btn-sm rounded-pill px-3">
                    <i class="fa-solid fa-eye-slash me-1"></i> Qaralama Rejiminə Keçir
                </button>
            </form>
        }
        else
        {
            <form asp-action="Publish" asp-route-id="@Model.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success btn-sm rounded-pill px-3">
                    <i class="fa-solid fa-cloud-arrow-up me-1"></i> Dərc Et (Publish)
                </button>
            </form>
        }
    </div>
</div>

<div class="row g-4">
    <!-- Kurs Detalları -->
    <div class="col-12 col-lg-4">
        <div class="card p-4 space-y-3">
            <h6 class="fw-bold border-bottom pb-2 mb-3">Kurs Haqqında</h6>
            <div class="mb-2">
                <span class="text-muted small d-block">Status:</span>
                @if (Model.Status == CourseStatus.Published)
                {
                    <span class="badge badge-soft-success">Dərc Edilib</span>
                }
                else
                {
                    <span class="badge badge-soft-warning">Qaralama</span>
                }
            </div>
            <div class="mb-2">
                <span class="text-muted small d-block">Qeydiyyatlı Tələbələr:</span>
                <span class="fw-bold">@Model.TotalEnrollments nəfər</span>
            </div>
            <div class="mb-2">
                <span class="text-muted small d-block">Səviyyə:</span>
                <span class="fw-semibold">@Model.Level</span>
            </div>
            <div class="mb-2">
                <span class="text-muted small d-block">Qiymət:</span>
                <span class="fw-bold text-primary">@(Model.IsFree ? "Pulsuz" : $"{Model.Price:C}")</span>
            </div>
            @if (!string.IsNullOrEmpty(Model.ShortDescription))
            {
                <div class="mt-3 pt-3 border-top">
                    <span class="text-muted small d-block">Qısa İzah:</span>
                    <p class="small text-secondary mb-0">@Model.ShortDescription</p>
                </div>
            }
        </div>
    </div>

    <!-- Modullar və Kurrikulum -->
    <div class="col-12 col-lg-8">
        <div class="card p-4">
            <h6 class="fw-bold border-bottom pb-2 mb-3">Kurrikulum (@(Model.Modules?.Count ?? 0) Modul)</h6>

            @if (Model.Modules == null || Model.Modules.Count == 0)
            {
                <div class="text-center py-4 text-muted">
                    <p class="small mb-0">Bu kursda hələ modul yaradılmayıb.</p>
                </div>
            }
            else
            {
                <div class="accordion" id="modulesAccordion">
                    @foreach (var mod in Model.Modules.OrderBy(m => m.OrderIndex))
                    {
                        <div class="accordion-item border rounded-3 mb-2 overflow-hidden">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed py-2.5 px-3 bg-light text-dark fw-semibold small" type="button" data-bs-toggle="collapse" data-bs-target="#mod-@mod.Id">
                                    <i class="fa-solid fa-folder-open text-primary me-2"></i> @mod.Title
                                    <span class="badge bg-secondary bg-opacity-25 text-dark ms-auto me-2" style="font-size: 10px;">@mod.Lessons.Count dərs</span>
                                </button>
                            </h2>
                            <div id="mod-@mod.Id" class="accordion-collapse collapse" data-bs-parent="#modulesAccordion">
                                <div class="accordion-body p-2 bg-white">
                                    <ul class="list-group list-group-flush small">
                                        @foreach (var lesson in mod.Lessons.OrderBy(l => l.OrderIndex))
                                        {
                                            <li class="list-group-item d-flex align-items-center justify-content-between py-2">
                                                <div>
                                                    <i class="fa-regular fa-circle-play text-muted me-2"></i>
                                                    <span>@lesson.Title</span>
                                                </div>
                                                <span class="text-muted" style="font-size: 11px;">@(lesson.DurationSeconds > 0 ? (lesson.DurationSeconds / 60) + " dəq" : "—")</span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
