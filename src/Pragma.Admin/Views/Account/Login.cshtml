@model Pragma.Admin.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Daxil Ol";
}

<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pragma LMS — Admin Giriş</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #1e293b;
        }
        .login-card {
            background-color: #ffffff;
            border-radius: 1.5rem;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.4);
            width: 100%;
            max-width: 420px;
            overflow: hidden;
        }
    </style>
</head>
<body>
    <div class="login-card p-4 p-sm-5">
        <div class="text-center mb-4">
            <div class="bg-primary text-white rounded-4 p-3 d-inline-flex align-items-center justify-content-center shadow-sm mb-3" style="width: 56px; height: 56px;">
                <i class="fa-solid fa-graduation-cap fa-xl"></i>
            </div>
            <h4 class="fw-bold mb-1 text-dark">Pragma Admin</h4>
            <p class="text-muted small mb-0">Tədris idarəetmə panelinə daxil olun</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger rounded-3 py-2 small" role="alert">
                <i class="fa-solid fa-circle-exclamation me-1"></i> @Model.ErrorMessage
            </div>
        }

        <form asp-controller="Account" asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="Email" class="form-label small fw-semibold text-secondary">Admin Email</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-regular fa-envelope"></i></span>
                    <input asp-for="Email" class="form-control border-start-0 ps-0" placeholder="admin@pragma.edu.az" required autofocus />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label small fw-semibold text-secondary">Şifrə</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-lock"></i></span>
                    <input asp-for="Password" class="form-control border-start-0 ps-0" placeholder="••••••••" required />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <!-- İlkin Məlumatları Doldur Düyməsi (Testing Convenience) -->
            <div class="mb-3 text-center">
                <button type="button" class="btn btn-link btn-sm text-primary text-decoration-none small" onclick="fillAdmin()">
                    <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Seed Admin məlumatlarını doldur
                </button>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2.5 rounded-3 fw-semibold shadow-sm">
                Sistemə Daxil Ol
            </button>
        </form>

        <div class="text-center mt-4 pt-3 border-top">
            <small class="text-muted d-block">Pragma Learning Management System</small>
            <div class="mt-2">
                <a href="http://localhost:5298/portal/index.html" target="_blank" class="text-secondary small text-decoration-none me-2">
                    <i class="fa-solid fa-laptop-code"></i> Tələbə Portalı
                </a>
                <a href="http://localhost:5298/scalar/v1" target="_blank" class="text-secondary small text-decoration-none">
                    <i class="fa-solid fa-code"></i> Scalar API
                </a>
            </div>
        </div>
    </div>

    <script>
        function fillAdmin() {
            document.getElementById('Email').value = 'admin@pragma.edu.az';
            document.getElementById('Password').value = 'PragmaAdmin2026!';
        }
    </script>
</body>
</html>
