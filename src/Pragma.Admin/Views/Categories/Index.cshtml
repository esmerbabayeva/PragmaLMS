@model Pragma.Admin.Models.CategoryListViewModel
@{
    ViewData["Title"] = "Kateqoriyalar";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-1">Kateqoriyaların İdarəsi 🗂️</h4>
        <p class="text-muted small mb-0">Platformadakı tədris sahələri və ixtisaslaşma kateqoriyaları.</p>
    </div>
    <button type="button" class="btn btn-primary btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#newCategoryModal">
        <i class="fa-solid fa-plus me-1"></i> Yeni Kateqoriya
    </button>
</div>

<!-- Kateqoriyalar Cədvəli -->
<div class="card p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-secondary small">
                <tr>
                    <th>Sıra</th>
                    <th>Kateqoriya Adı</th>
                    <th>Slug</th>
                    <th>Açıqlama</th>
                    <th>Kurs Sayı</th>
                    <th>İkon</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cat in Model.Categories.OrderBy(c => c.SortOrder))
                {
                    <tr>
                        <td class="fw-bold text-muted small">@cat.SortOrder</td>
                        <td class="fw-bold text-dark">@cat.Name</td>
                        <td class="font-monospace small text-muted">@cat.Slug</td>
                        <td class="small text-secondary">@(string.IsNullOrEmpty(cat.Description) ? "—" : cat.Description)</td>
                        <td>
                            <span class="badge bg-primary bg-opacity-10 text-primary">@cat.CourseCount kurs</span>
                        </td>
                        <td>
                            <code class="small text-muted">@(cat.IconName ?? "folder")</code>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Yeni Kateqoriya Modal Pəncərəsi -->
<div class="modal fade" id="newCategoryModal" tabindex="-1" aria-labelledby="newCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold" id="newCategoryModalLabel">Yeni Kateqoriya Əlavə Et</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body space-y-3">
                    <div class="mb-3">
                        <label asp-for="NewCategory.Name" class="form-label small fw-semibold">Kateqoriya Adı (AZ - Əsas)</label>
                        <input asp-for="NewCategory.Name" class="form-control rounded-3" placeholder="Məs: Mobil Proqramlaşdırma" required />
                        <span asp-validation-for="NewCategory.Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewCategory.Description" class="form-label small fw-semibold">Açıqlama (AZ)</label>
                        <textarea asp-for="NewCategory.Description" class="form-control rounded-3" rows="2" placeholder="Flutter, Swift və Android tədris modulları..."></textarea>
                    </div>

                    <div class="p-3 bg-light rounded-3 mb-3 border">
                        <div class="fw-bold small text-secondary mb-2">🌐 Çoxdilli Tərcümələr (İxtiyari)</div>
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label asp-for="NewCategory.NameEn" class="form-label small text-muted">Ad (EN)</label>
                                <input asp-for="NewCategory.NameEn" class="form-control form-control-sm rounded-2" placeholder="Mobile Development" />
                            </div>
                            <div class="col-6">
                                <label asp-for="NewCategory.NameRu" class="form-label small text-muted">Ad (RU)</label>
                                <input asp-for="NewCategory.NameRu" class="form-control form-control-sm rounded-2" placeholder="Мобильная разработка" />
                            </div>
                        </div>
                        <div class="row g-2">
                            <div class="col-6">
                                <label asp-for="NewCategory.DescriptionEn" class="form-label small text-muted">Açıqlama (EN)</label>
                                <textarea asp-for="NewCategory.DescriptionEn" class="form-control form-control-sm rounded-2" rows="2" placeholder="Flutter, Swift and Android..."></textarea>
                            </div>
                            <div class="col-6">
                                <label asp-for="NewCategory.DescriptionRu" class="form-label small text-muted">Açıqlama (RU)</label>
                                <textarea asp-for="NewCategory.DescriptionRu" class="form-control form-control-sm rounded-2" rows="2" placeholder="Модули Flutter, Swift..."></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="row g-2">
                        <div class="col-6 mb-3">
                            <label asp-for="NewCategory.IconName" class="form-label small fw-semibold">İkon Adı</label>
                            <input asp-for="NewCategory.IconName" class="form-control rounded-3" placeholder="device-phone-mobile" />
                        </div>
                        <div class="col-6 mb-3">
                            <label asp-for="NewCategory.SortOrder" class="form-label small fw-semibold">Sıra №</label>
                            <input asp-for="NewCategory.SortOrder" type="number" class="form-control rounded-3" value="1" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">İmtina</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Yarat</button>
                </div>
            </form>
        </div>
    </div>
</div>
