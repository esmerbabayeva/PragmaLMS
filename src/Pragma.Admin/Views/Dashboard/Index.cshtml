@model Pragma.Admin.Models.DashboardViewModel
@using Pragma.Domain.Enums
@{
    ViewData["Title"] = "İdarəetmə Paneli";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-1">Xoş gəldiniz, Admin! 👋</h4>
        <p class="text-muted small mb-0">Pragma LMS platformasının əsas statistikası və son fəaliyyətlər.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Categories" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill px-3">
            <i class="fa-solid fa-plus me-1"></i> Yeni Kateqoriya
        </a>
        <a asp-controller="Courses" asp-action="Index" class="btn btn-primary btn-sm rounded-pill px-3">
            <i class="fa-solid fa-book-open me-1"></i> Bütün Kurslar
        </a>
    </div>
</div>

<!-- 1. STATİSTİKA KARTLARI -->
<div class="row g-3 mb-4">
    <!-- Ümumi Kurslar -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card p-3 h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-semibold text-uppercase">Ümumi Kurslar</span>
                <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                    <i class="fa-solid fa-book"></i>
                </div>
            </div>
            <h3 class="fw-bold mb-1">@Model.TotalCourses</h3>
            <small class="text-muted" style="font-size: 11px;">Bazada mövcud olan kurslar</small>
        </div>
    </div>

    <!-- Dərc Edilmiş Kurslar -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card p-3 h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-semibold text-uppercase">Aktiv Kurslar</span>
                <div class="bg-success bg-opacity-10 text-success rounded-3 p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
            </div>
            <h3 class="fw-bold mb-1 text-success">@Model.PublishedCourses</h3>
            <small class="text-muted" style="font-size: 11px;">Tələbələr üçün açıq (Published)</small>
        </div>
    </div>

    <!-- Kateqoriyalar -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card p-3 h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-semibold text-uppercase">Kateqoriyalar</span>
                <div class="bg-warning bg-opacity-10 text-warning rounded-3 p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                    <i class="fa-solid fa-layer-group"></i>
                </div>
            </div>
            <h3 class="fw-bold mb-1">@Model.TotalCategories</h3>
            <small class="text-muted" style="font-size: 11px;">İxtisaslaşmış tədris sahələri</small>
        </div>
    </div>

    <!-- Lider Tələbələr -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card p-3 h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-semibold text-uppercase">Lider Tələbələr</span>
                <div class="bg-danger bg-opacity-10 text-danger rounded-3 p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                    <i class="fa-solid fa-fire text-danger"></i>
                </div>
            </div>
            <h3 class="fw-bold mb-1">@Model.TopStudents.Count</h3>
            <small class="text-muted" style="font-size: 11px;">Streak və XP üzrə liderlər</small>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- 2. SON KURSLAR VƏ İDARƏETMƏ CƏDVƏLİ -->
    <div class="col-12 col-lg-8">
        <div class="card p-4 h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h6 class="fw-bold mb-0">Son Əlavə Edilmiş Kurslar</h6>
                <a asp-controller="Courses" asp-action="Index" class="text-primary small text-decoration-none fw-semibold">
                    Hamısına bax <i class="fa-solid fa-arrow-right ms-1"></i>
                </a>
            </div>

            @if (Model.RecentCourses.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="fa-solid fa-inbox fa-2xl mb-3 opacity-50"></i>
                    <p class="small mb-0">Hələ ki heç bir kurs əlavə edilməyib.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr class="text-secondary small">
                                <th>Kurs Adı</th>
                                <th>Kateqoriya</th>
                                <th>Status</th>
                                <th class="text-end">Əməliyyat</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var course in Model.RecentCourses)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@course.Title</div>
                                        <small class="text-muted">@course.InstructorName</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary">@course.CategoryName</span>
                                    </td>
                                    <td>
                                        @if (course.Status == CourseStatus.Published)
                                        {
                                            <span class="badge badge-soft-success">Dərc Edilib</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-soft-warning">Qaralama</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="Courses" asp-action="Details" asp-route-id="@course.Id" class="btn btn-outline-secondary btn-sm" title="Detallar">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        <a asp-controller="Courses" asp-action="Gradebook" asp-route-id="@course.Id" class="btn btn-outline-primary btn-sm ms-1" title="Qiymət Jurnalı">
                                            <i class="fa-solid fa-table-list"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- 3. TOP TƏLƏBƏLƏR (LEADERBOARD WIDGET) -->
    <div class="col-12 col-lg-4">
        <div class="card p-4 h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h6 class="fw-bold mb-0">🔥 Top Lider Tələbələr</h6>
                <span class="badge bg-warning bg-opacity-25 text-dark fw-bold">Gamification</span>
            </div>

            @if (Model.TopStudents.Count == 0)
            {
                <div class="text-center py-4 text-muted">
                    <small>Liderlik cədvəli boşdur.</small>
                </div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @for (int i = 0; i < Model.TopStudents.Count; i++)
                    {
                        var student = Model.TopStudents[i];
                        <div class="list-group-item px-0 py-2.5 d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2.5">
                                <span class="fw-bold text-muted" style="width: 20px;">
                                    @(i == 0 ? "🥇" : (i == 1 ? "🥈" : (i == 2 ? "🥉" : (i + 1).ToString())))
                                </span>
                                <div>
                                    <div class="fw-semibold small text-dark">@(string.IsNullOrEmpty(student.FullName) ? "Tələbə" : student.FullName)</div>
                                    <small class="text-muted" style="font-size: 11px;">🎖️ @student.BadgesCount qazanılmış nişan</small>
                                </div>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-danger bg-opacity-10 text-danger fw-bold">🔥 @student.CurrentStreak gün</span>
                                <div class="text-primary fw-bold" style="font-size: 11px;">@student.TotalXp XP</div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
